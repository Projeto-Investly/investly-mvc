<%- include("../partials/head", { title: "Perfil", description: "Área do usuário Investly", bodyClass: "app-body" }) %>
<div class="app-shell">
<%- include("../partials/app-sidebar", { active: "perfil" }) %>
<%- include("../partials/app-header", { usuario }) %>
<main id="main" class="app-main">
    <div class="container app-content">

        <div class="section-head"><span class="eyebrow">Conta</span><h1 style="font-size:2rem">Meu perfil</h1><p class="muted">Gerencie suas informações.</p></div>
        <div class="grid grid-2">
            <form class="card card-pad" method="post" action="/perfil">
                <%- include("../partials/errors", { errors }) %>
                <div class="form-group"><label for="name">Nome completo</label><input id="name" name="name" value="<%= dados?.name || usuario.nome %>" required></div>
                <div class="form-group"><label for="email">E-mail</label><input id="email" name="email" type="email" value="<%= dados?.email || usuario.email %>" required></div>
                <button class="btn btn-primary" type="submit">Salvar alterações</button>
            </form>
            <div class="card card-pad">
                <h3>Perfil financeiro</h3>
                <div class="data-list">
                    <div class="data-row"><span>Renda aproximada</span><strong>R$ <%= usuario.renda %></strong></div>
                    <div class="data-row"><span>Nível</span><strong><%= usuario.nivel %></strong></div>
                </div>
            </div>
        </div>

    </div>
</main>
<%- include("../partials/bottom-nav", { active: "perfil" }) %>
</div>
<%- include("../partials/end") %>
