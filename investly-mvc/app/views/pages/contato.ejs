<%- include("../partials/head", { title: "Contato", description: "Investly — organização e educação financeira.", bodyClass: "" }) %>
<%- include("../partials/header") %>
<main id="main">

<section class="section">
<div class="container grid grid-2">
    <div>
        <span class="eyebrow">Contato</span>
        <h1>Fale com o Investly.</h1>
        <p class="muted">Encontrou um problema ou tem uma sugestão? Envie uma mensagem.</p>
    </div>
    <form class="card card-pad" method="post" action="/contato">
        <%- include("../partials/errors", { errors }) %>
        <div class="form-group"><label for="name">Nome</label><input id="name" name="name" value="<%= dados?.name || '' %>" required></div>
        <div class="form-group"><label for="email">E-mail</label><input id="email" name="email" type="email" value="<%= dados?.email || '' %>" required></div>
        <div class="form-group"><label for="message">Mensagem</label><textarea id="message" name="message" required><%= dados?.message || '' %></textarea></div>
        <button class="btn btn-primary btn-block" type="submit">Enviar mensagem</button>
    </form>
</div>
</section>

</main>
<%- include("../partials/footer") %>
<%- include("../partials/end") %>
