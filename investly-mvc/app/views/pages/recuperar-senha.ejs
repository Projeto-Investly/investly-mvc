<%- include("../partials/head", { title: "Recuperar senha", description: "Acesso ao Investly", bodyClass: "auth-page" }) %>
<main id="main" class="auth-shell">
    <%- include("../partials/auth-aside") %>
    <section class="auth-form">
        <a class="brand auth-logo" href="/">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            Investly
        </a>

        <h2>Recupere sua senha</h2>
        <p class="muted">Digite seu e-mail para continuar.</p>
        <form method="post" action="/recuperar-senha" style="margin-top:24px">
            <%- include("../partials/errors", { errors }) %>
            <div class="form-group"><label for="email">E-mail</label><input id="email" name="email" type="email" value="<%= dados?.email || '' %>" required></div>
            <button class="btn btn-primary btn-block" type="submit">Enviar recuperação</button>
        </form>

    </section>
</main>
<%- include("../partials/end") %>
