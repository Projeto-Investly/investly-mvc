<%- include("../partials/head", { title: "Adicionar despesa", description: "Área do usuário Investly", bodyClass: "app-body" }) %>
<div class="app-shell">
<%- include("../partials/app-sidebar", { active: "financas" }) %>
<%- include("../partials/app-header", { usuario }) %>
<main id="main" class="app-main">
    <div class="container app-content">

        <div class="section-head"><span class="eyebrow">Finanças</span><h1 style="font-size:2rem">Adicionar despesa</h1><p class="muted">Registre essa movimentação.</p></div>
        <div class="card card-pad" style="max-width:720px">
            <form method="post" action="/financas/despesas/nova">
                <%- include("../partials/errors", { errors }) %>
                <div class="form-group"><label for="description">Descrição</label><input id="description" name="description" value="<%= dados?.description || '' %>" required></div>
                <div class="form-group"><label for="value">Valor</label><input id="value" name="value" type="number" step="0.01" min="0.01" value="<%= dados?.value || '' %>" required></div>
                <div class="form-group"><label for="date">Data</label><input id="date" name="date" type="date" value="<%= dados?.date || '' %>" required></div>
                <div class="form-group"><label for="category">Categoria</label><input id="category" name="category" value="<%= dados?.category || '' %>" required></div>
                <div style="display:flex;gap:10px"><a class="btn btn-secondary" href="/financas">Cancelar</a><button class="btn btn-orange" type="submit">Salvar despesa</button></div>
            </form>
        </div>

    </div>
</main>
<%- include("../partials/bottom-nav", { active: "financas" }) %>
</div>
<%- include("../partials/end") %>
