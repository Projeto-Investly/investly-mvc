<%- include("../partials/head", { title: "Metas", description: "Área do usuário Investly", bodyClass: "app-body" }) %>
<div class="app-shell">
<%- include("../partials/app-sidebar", { active: "metas" }) %>
<%- include("../partials/app-header", { usuario }) %>
<main id="main" class="app-main">
    <div class="container app-content">

        <div class="toolbar">
            <div><span class="eyebrow">Metas</span><h1 style="font-size:2rem">Transforme planos em objetivos.</h1><p class="muted">Acompanhe o caminho até cada conquista.</p></div>
            <a class="btn btn-orange" href="/metas/nova">+ Criar meta</a>
        </div>
        <div class="grid grid-3">
        <% metas.forEach(meta => { %>
            <div class="card card-pad goal-card">
                <div class="goal-top"><h3><%= meta.nome %></h3><strong><%= meta.progresso %>%</strong></div>
                <div class="goal-amount">R$ <%= meta.atual %> de R$ <%= meta.objetivo %></div>
                <div class="progress"><span style="width:<%= meta.progresso %>%"></span></div>
                <a class="btn btn-secondary btn-sm" href="/metas/<%= meta.id %>">Ver detalhes</a>
            </div>
        <% }) %>
        </div>

    </div>
</main>
<%- include("../partials/bottom-nav", { active: "metas" }) %>
</div>
<%- include("../partials/end") %>
